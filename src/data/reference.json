  "groups": [
    {
      "name": "Airbus narrowbody",
      "note": "Single-aisle Airbus jets. These are the workhorses of short and medium domestic routes, and the type you are most likely to see overhead in daylight hours near a major city."
    },
    {
      "name": "Airbus widebody",
      "note": "Twin-aisle Airbus jets used on long-haul routes. Overhead they are usually either high and level in cruise, or descending on a long, shallow approach after an ocean crossing."
    },
    {
      "name": "Boeing narrowbody",
      "note": "Single-aisle Boeing jets, dominated by the 737 family. The trailing digit of the code is the variant, so B738 is a 737-800."
    },
    {
      "name": "Boeing widebody",
      "note": "Twin-aisle Boeing jets. The 777 and 787 codes turn up on long-haul passenger routes; 747 and 767 codes increasingly belong to freighters."
    },
    {
      "name": "McDonnell Douglas",
      "note": "Legacy trijets and MD-80 series twins. Almost all remaining airframes now fly cargo, so these codes usually appear at night."
    },
    {
      "name": "Embraer",
      "note": "Brazilian regional jets. The E-Jet family (E170 through E195) carries most short-haul regional traffic in North America and Europe."
    },
    {
      "name": "Regional jets",
      "note": "Bombardier CRJ family — 50 to 100 seats, feeding hub airports from smaller cities. Distinctive for their rear-mounted engines and T-tail."
    },
    {
      "name": "Turboprops",
      "note": "Propellers driven by turbine engines. Slower and lower than jets, which is why they often show the lowest altitudes on the radar card while still being airline traffic."
    },
    {
      "name": "Business jets",
      "note": "Corporate and charter aircraft. They cruise as high as airliners but are far smaller, and their callsigns are usually the registration rather than an airline code."
    },
    {
      "name": "General aviation",
      "note": "Light piston aircraft — training flights, personal travel, sightseeing. Typically below 10,000 ft and slower than 180 knots."
    },
    {
      "name": "Helicopters",
      "note": "Rotorcraft: medical transport, law enforcement, news, offshore and sightseeing work. They show low altitudes and erratic headings because they are not confined to airways."
    },
    {
      "name": "Military and special mission",
      "note": "Transport and patrol aircraft that broadcast position openly. Combat aircraft generally do not, which is why they rarely appear."
    }
  ]
}
